shader_type spatial;
render_mode blend_mix,depth_draw_always,depth_prepass_alpha,cull_disabled;

// This shader assumes you exported a model in Blender using OpenVAT using these settings:
// "Vertex Normals" = "Packed"
// "Use Single Row" checked
// "Export Model" checked
// "Model Format" = "glTF Binary" (other formats result in a broken animation as of 2026-02-09)


/*
Multi animation track OpenVAT Shader - by Antz 2026

INSTANCE_CUSTOM is used to display a unique animation per instance.
It has total of 4 floats. All renderers supported.

	Red channel:
		animation offset: used to randomize instances playing the same animation track

	Green channel:
		animation start frame

	Blue channel:
		animation end frame

	Alpha channel:
		alpha of mesh: used to fade in/out a unique instance
		
Instanced COLOR is used for looping / non-looping (also called one_shot) animations.
It has total of 4 floats. All renderers supported.

	Red channel:
		is_looping: 1.0 = true, 0.0 = false

	Green channel:
		timestamp:
			if looping - when the looping animation started.
			if non-lopping - Tells the shader when the one_shot has been reset.

	Blue channel: 
			animation frame rate - must be greater than 0
	
	Alpha channel: not used
*/

group_uniforms OpenVAT;
/**
[b]Required.[/b] Texture generated by OpenVAT, exported using these parameters:
- [b]"Vertex Normals" = "Packed"[/b] (meaning the texture contains both position & normal offsets)
- [b]"Use Single Row"[/b] checked
*/
uniform sampler2D vertex_animation_texture : filter_nearest, repeat_disable;
// Horde-owned clock follows game pause/time scale, unlike shader TIME.
uniform bool use_animation_clock = false;
uniform float animation_clock = 0.0;
uniform bool use_pose_transitions = false;
uniform sampler2D transition_poses : filter_nearest, repeat_disable;
uniform float transition_duration = 0.18;
// OpenVATBlendController: three RGBAF rows per instance, with advancing source clips.
// Opt-in; legacy immediate switching and frozen-pose transitions remain supported.
uniform bool use_clip_blending = false;
uniform sampler2D blend_metadata : filter_nearest, repeat_disable;
/** [b]Required.[/b] Min values for X, Y, Z, copied from `remap_info.json` (generated by OpenVAT) */
uniform vec3 min_values;
/** [b]Required.[/b] Max values for X, Y, Z, copied from `remap_info.json` (generated by OpenVAT) */
uniform vec3 max_values;

///** Animation frame shown when paused */
//uniform int pause_frame;
/** Number of frames per second. The default value in Blender is 30 (see "Scene > Format > Frame Rate" in Blender). */
//uniform float speed = 30.0;
group_uniforms;

group_uniforms Albedo;
uniform vec4 albedo : source_color = vec4(1.0); // Opaque white by default
uniform sampler2D albedo_texture : source_color;
group_uniforms;

group_uniforms Metallic;
uniform sampler2D metallic_texture : hint_default_white;
uniform float metallic : hint_range(0.0, 1.0) = 0.0;
uniform vec4 metallic_texture_channel: source_color = vec4(1.0, 0.0, 0.0, 0.0); // Red channel by default
uniform float specular : hint_range(0.0, 1.0) = 0.5;
group_uniforms;

group_uniforms Roughness;
uniform sampler2D roughness_texture : hint_roughness_r;
uniform float roughness : hint_range(0.0, 1.0) = 1.0;
uniform vec4 roughness_texture_channel : source_color = vec4(1.0, 0.0, 0.0, 0.0); // Red channel by default
group_uniforms;

group_uniforms NormalMap;
uniform sampler2D normal_map_texture : hint_roughness_normal;
uniform float normal_scale : hint_range(-16.0, 16.0) = 1.0;
group_uniforms;

varying flat vec4 custom_data;
varying flat vec4 color_data;

vec3 blenderToGodot(vec3 v) {
	return vec3(v.x, v.z, -v.y);
}

vec3 interpolateVatOffset(vec2 current_offset_uv, vec2 next_offset_uv, float blend) {
	vec3 current_offset = texture(vertex_animation_texture, current_offset_uv).rgb;
	vec3 next_offset = texture(vertex_animation_texture, next_offset_uv).rgb;
	return mix(current_offset, next_offset, blend);
}

vec3 rescalePosition(vec3 position) {
	return min_values + position * (max_values - min_values);
}

vec3 rescaleNormal(vec3 normal) {
	// Rescale from [0, 1] to [-1, 1]
	return 2.0 * normal - 1.0;
}

void vertex() {
	custom_data = INSTANCE_CUSTOM;
	color_data = COLOR;
	
	bool is_looping = color_data.r > 0.5; // 1.0 = true, 0.0 = false
	float timestamp = color_data.g;

	float start_frame = custom_data.g;
	float end_frame = custom_data.b;
	float num_frames = max(end_frame - start_frame + 1.0, 1.0);
	float frame_offset = num_frames * custom_data.r;
	float speed = max(0.001, color_data.b);

	ivec2 resolution = textureSize(vertex_animation_texture, 0);

	float now = use_animation_clock ? animation_clock : TIME;
	float cursor = max(now - timestamp, 0.0) * speed + frame_offset;
	cursor = is_looping ? mod(cursor, num_frames) : clamp(cursor, 0.0, num_frames - 1.0);
	float current_frame = start_frame + floor(cursor);
	float next_frame = current_frame + 1.0;
	if (next_frame > end_frame) next_frame = is_looping ? start_frame : end_frame;
	float blend = fract(cursor);

	// Calculate the UV offset for the current frame
	float frame_step = 1.0 / float(resolution.y);
	vec2 current_offset_uv = UV2 + vec2(0.0, current_frame * frame_step);
	vec2 next_offset_uv = UV2 + vec2(0.0, next_frame * frame_step);

	// Apply the remapped position to the vertex
	vec3 position_offset = interpolateVatOffset(current_offset_uv, next_offset_uv, blend);

	// Normals are stored on the lower half of the Vertex Animation Texture,
	// so we need to shift the UV to be on that lower half to read normals.
	vec2 normals_uv_shift = vec2(0.0, 0.5);
	vec3 normal_offset = interpolateVatOffset(
			current_offset_uv + normals_uv_shift,
			next_offset_uv + normals_uv_shift,
			blend
		);
	if (use_clip_blending) {
		vec4 flags = texelFetch(blend_metadata, ivec2(INSTANCE_ID, 2), 0);
		if (flags.r > 0.5) {
			vec4 timing = texelFetch(blend_metadata, ivec2(INSTANCE_ID, 1), 0);
			float weight = timing.a > 0.0 ? smoothstep(0.0, timing.a, max(now - timing.b, 0.0)) : 1.0;
			if (weight < 1.0) {
				vec4 source = texelFetch(blend_metadata, ivec2(INSTANCE_ID, 0), 0);
				float old_count = max(source.g - source.r + 1.0, 1.0);
				bool old_loops = timing.g > 0.5;
				float old_cursor = max(now - source.b, 0.0) * max(source.a, 0.001) + old_count * timing.r;
				old_cursor = old_loops ? mod(old_cursor, old_count) : clamp(old_cursor, 0.0, old_count - 1.0);
				float old_frame = source.r + floor(old_cursor);
				float old_next = old_frame + 1.0;
				if (old_next > source.g) old_next = old_loops ? source.r : source.g;
				vec2 old_uv = UV2 + vec2(0.0, old_frame * frame_step);
				vec2 old_next_uv = UV2 + vec2(0.0, old_next * frame_step);
				position_offset = mix(interpolateVatOffset(old_uv, old_next_uv, fract(old_cursor)), position_offset, weight);
				normal_offset = mix(interpolateVatOffset(old_uv + normals_uv_shift, old_next_uv + normals_uv_shift, fract(old_cursor)), normal_offset, weight);
			}
		}
	} else if (use_pose_transitions) {
		vec4 previous = texelFetch(transition_poses, ivec2(INSTANCE_ID, 0), 0);
		float weight = smoothstep(0.0, max(transition_duration, 0.001), now - previous.a);
		// Most instances have finished blending; avoid extra VAT reads for them.
		if (weight < 1.0) {
			vec2 old_uv = UV2 + vec2(0.0, previous.r * frame_step);
			vec2 old_next_uv = UV2 + vec2(0.0, previous.g * frame_step);
			position_offset = mix(interpolateVatOffset(old_uv, old_next_uv, previous.b), position_offset, weight);
			normal_offset = mix(interpolateVatOffset(old_uv + normals_uv_shift, old_next_uv + normals_uv_shift, previous.b), normal_offset, weight);
		}
	}
	VERTEX += blenderToGodot(rescalePosition(position_offset));
	vec3 decoded_normal = blenderToGodot(rescaleNormal(normal_offset));
	// Opposing source normals can cancel midway through a crossfade.
	NORMAL = dot(decoded_normal, decoded_normal) > 0.000001 ? normalize(decoded_normal) : vec3(0.0, 1.0, 0.0);

	// Recomputes TANGENT & BIPLANAR based on the updated NORMAL (taken from the Godot source)
	TANGENT = normalize(vec3(abs(NORMAL.y) + abs(NORMAL.z), 0.0, -abs(NORMAL.x)));
	BINORMAL = normalize(vec3(0.0, abs(NORMAL.x) + abs(NORMAL.z), -abs(NORMAL.y)));
}

void fragment() {
	ALBEDO = albedo.rgb * texture(albedo_texture, UV).rgb;
	METALLIC = dot(texture(metallic_texture, UV), metallic_texture_channel) * metallic;
	SPECULAR = specular;
	ROUGHNESS = dot(texture(roughness_texture, UV), roughness_texture_channel) * roughness;
	NORMAL_MAP = texture(normal_map_texture, UV).rgb;
	NORMAL_MAP_DEPTH = normal_scale;
	ALPHA = custom_data.a;  // fader
}
